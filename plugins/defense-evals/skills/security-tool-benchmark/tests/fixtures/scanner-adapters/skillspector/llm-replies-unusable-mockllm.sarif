          "properties": {
            "findingId": "finding-e24498fae46d4728af0016e27f39037e",
            "severity": "MEDIUM",
            "security-severity": "5.5",
            "category": "MCP Least Privilege",
            "pattern": "Skill declares no tool scope ('permissions' or 'allowed-tools') but code capabilities were detected: network, shell.",
            "confidence": 0.7,
            "finding": "Skill declares no tool scope ('permissions' or 'allowed-tools') but code capabilities were detected: network, shell.",
            "explanation": "Without declared permissions the skill's intent is opaque and cannot be validated.",
            "remediation": "Clarify the skill's intended tool scope and review how the host runtime enforces it; runtime permissions are unknown unless separately verified. For Claude Code / Agent Skills SKILL.md, 'allowed-tools' records preapproved tools, not a permission ceiling; add a tool only when it is independently approved as necessary, not to silence this finding. For MCP server manifests, use a 'permissions' list naming the required capabilities.",
            "tags": [
              "ASI02"
            ],
            "evidence": {
              "llm_review_outcome": "failed"
            },
            "surface": "instructions"
          }
