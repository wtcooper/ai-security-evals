                "security-severity": "8.0"
              }
            },
            {
              "id": "LP3",
              "shortDescription": {
                "text": "Skill declares no tool scope ('permissions' or 'allowed-tools') but code capabilities were detected: network, shell."
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "SSRF2",
              "shortDescription": {
                "text": "Internal Network Request"
              },
              "properties": {
                "security-severity": "5.5"
              }
            },
            {
              "id": "TT5",
              "shortDescription": {
                "text": "Tainted flow: 'code' from urllib.request.urlopen (line 3, network input) \u2192 exec (code execution)"
              },
              "properties": {
                "security-severity": "9.5"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "TT5",
          "message": {
            "text": "Tainted flow: 'code' from urllib.request.urlopen (line 3, network input) \u2192 exec (code execution)"
