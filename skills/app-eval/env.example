# app-eval — copy to .env and fill (`cp env.example .env`; .env is gitignored).
# The TARGET is your application; the JUDGE is an OpenAI-compatible gateway.

# --- target application under test ---
TARGET_URL=https://your-app.internal/chat
TARGET_API_KEY=

# --- judge (LLM-as-judge for llm-rubric grading) ---
# JUDGE_URL must be the full chat-completions endpoint.
JUDGE_URL=https://litellm.internal/v1/chat/completions
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini

# Optional: vendors that block with a non-400 status (e.g. Prisma AIRS 446)
# GUARDRAIL_BLOCK_STATUSES=400,446
