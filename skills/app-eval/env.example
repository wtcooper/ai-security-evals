# app-eval — copy to .env and fill (`cp env.example .env`; .env is gitignored).
# The TARGET is your application; the JUDGE is an OpenAI-compatible gateway.

# ---- FULLY LOCAL profile (no key, no spend) — start the gateway first:
#        bash targets/proxy/start_proxy.sh
# Uncomment this block to run target + judge through the local LiteLLM gateway:
# TARGET_URL=http://localhost:4000/v1/chat/completions
# TARGET_API_KEY=sk-mock
# TARGET_MODEL=gemma4:e2b
# JUDGE_BASE_URL=http://localhost:4000/v1
# JUDGE_API_KEY=sk-mock
# JUDGE_MODEL=gemma4

# --- target application under test ---
TARGET_URL=https://your-app.internal/chat
TARGET_API_KEY=
TARGET_MODEL=                          # set for an OpenAI-style endpoint; else delete the body line

# --- judge (LLM-as-judge for llm-rubric grading; OpenAI-compatible) ---
# JUDGE_BASE_URL is the gateway BASE (…/v1), not the full chat-completions path.
JUDGE_BASE_URL=https://litellm.internal/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini

# --- block detection (usually leave unset) ---
# Blocks are detected body-first (action:block / blocked / flagged / guardrail_name /
# "content blocked" message), so most vendors — incl. LiteLLM's 403 content-filter —
# are caught with NO config. These are only hints/overrides for unusual cases:
#
# Add a status that should ALWAYS count as a block even with no body signal (hint):
# GUARDRAIL_BLOCK_STATUSES=400,446
#
# What to do with an AMBIGUOUS non-2xx (no block or infra signal): judge it (default)
# or exclude it. The per-status histogram in `summarize.py` flags these either way.
# GUARDRAIL_AMBIGUOUS_POLICY=judge   # or: exclude
