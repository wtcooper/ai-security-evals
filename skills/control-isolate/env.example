# control-isolate — copy to .env and fill (`cp env.example .env`; .env is gitignored).

# --- the guardrail / classifier endpoint under test (no model in the loop) ---
GUARDRAIL_URL=https://guardrail.vendor/v1/scan
GUARDRAIL_API_KEY=

# --- block-signal mapping (usually leave unset) ---
# The adapter recognizes action:block / blocked / flagged / is_malicious / a
# guardrail_name / "content blocked" message body-first (a 400 is a status hint), so
# most guardrails work with no config. An unmapped non-2xx is surfaced LOUDLY (excluded
# with a message naming the status) rather than silently bucketed. Override for odd shapes:
# GUARDRAIL_BLOCK_STATUSES=400,446        # statuses that should always count as a block
# GUARDRAIL_BLOCK_FIELD=result.verdict    # dotted path to the decision field
# GUARDRAIL_BLOCK_VALUE=unsafe            # value that means "blocked"
