# control-isolate — copy to .env and fill (`cp env.example .env`; .env is gitignored).

# --- the guardrail / classifier endpoint under test (no model in the loop) ---
GUARDRAIL_URL=https://guardrail.vendor/v1/scan
GUARDRAIL_API_KEY=

# --- block-signal mapping (only if the generic recognizers don't fit) ---
# The adapter recognizes action:block / blocked:true / flagged:true / is_malicious:true
# and a 400 status by default. Override for odd vendors:
# GUARDRAIL_BLOCK_STATUSES=400,446        # vendors that block via a status code
# GUARDRAIL_BLOCK_FIELD=result.verdict    # dotted path to the decision field
# GUARDRAIL_BLOCK_VALUE=unsafe            # value that means "blocked"
