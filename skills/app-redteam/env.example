# app-redteam — copy to .env and fill (`cp env.example .env`; .env is gitignored).

# --- target application under test ---
TARGET_URL=https://your-app.internal/chat
TARGET_API_KEY=

# --- attacker model (generates/adapts the adversarial turns) ---
# OpenAI-compatible; point at your production LiteLLM. Use a capable instruct model.
ATTACKER_MODEL=gpt-4o
ATTACKER_BASE_URL=https://litellm.internal/v1
ATTACKER_API_KEY=

# --- grader model (judges whether an attack succeeded) ---
# Keep DIFFERENT from the target. OpenAI-compatible.
GRADER_MODEL=gpt-4o-mini
GRADER_BASE_URL=https://litellm.internal/v1
GRADER_API_KEY=
