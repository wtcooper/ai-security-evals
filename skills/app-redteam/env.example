# app-redteam — copy to .env and fill (`cp env.example .env`; .env is gitignored).
#
# Two ready profiles below. Uncomment ONE block.

# ============================================================================
# PROFILE A — FULLY LOCAL (no API key, no spend). Target + attacker + grader all
# run through the local LiteLLM gateway -> Ollama. Start it first:
#   bash targets/proxy/start_proxy.sh
# ----------------------------------------------------------------------------
TARGET_URL=http://localhost:4000/v1/chat/completions
TARGET_API_KEY=sk-mock
TARGET_MODEL=gemma4:e2b              # the app/model under test

ATTACKER_MODEL=gemma4                # drives crescendo turns (full model > e2b)
ATTACKER_BASE_URL=http://localhost:4000/v1
ATTACKER_API_KEY=sk-mock

GRADER_MODEL=gemma4                  # judges success; keep != target where possible
GRADER_BASE_URL=http://localhost:4000/v1
GRADER_API_KEY=sk-mock

# ============================================================================
# PROFILE B — REAL APP + PRODUCTION GATEWAY. Comment out Profile A and use this.
# ----------------------------------------------------------------------------
# TARGET_URL=https://your-app.internal/chat
# TARGET_API_KEY=
# TARGET_MODEL=                      # set if your app's body needs a model; else delete the body line

# ATTACKER_MODEL=gpt-4o              # a capable instruct model attacks best
# ATTACKER_BASE_URL=https://litellm.internal/v1
# ATTACKER_API_KEY=

# GRADER_MODEL=gpt-4o-mini           # keep DIFFERENT from the target
# GRADER_BASE_URL=https://litellm.internal/v1
# GRADER_API_KEY=
