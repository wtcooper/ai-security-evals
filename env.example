# ai-security-evals — sample environment file
#
# Copy this to .env.local (gitignored) and fill in any keys you actually need.
# The local LiteLLM proxy's start_proxy.sh sources .env.local automatically;
# the ai-guardrail-eval CLI reads the LITELLM_* / JUDGE_* / HF_TOKEN values
# at run time.
#
#   cp env.example .env.local
#   $EDITOR .env.local
#
# Defaults work out-of-the-box for the bundled mock proxy — you only need to
# set real values when testing real upstream models or real guardrails.

# ---- LiteLLM gateway the harness points at -------------------------------
# Defaults assume the bundled local proxy on port 4000 with master_key sk-mock.
# Override BOTH if you're pointing at a remote LiteLLM gateway you control.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-mock

# ---- LLM-as-judge ---------------------------------------------------------
# Judge model is required for every test (no keyword-classifier fallback).
# JUDGE_BASE_URL / JUDGE_API_KEY default to the LITELLM_* values above; only
# set them if your judge lives on a different gateway than the target.
# Use a small, fast, well-calibrated model. mock-judge works against the
# bundled proxy for pipeline testing only.
JUDGE_MODEL=mock-judge
# JUDGE_BASE_URL=https://your-other-litellm.example.com
# JUDGE_API_KEY=sk-...

# ---- Real upstream model keys (for local/litellm_config.yaml) ------------
# Uncomment + set whatever providers you've enabled in the proxy config.
# These are read by LiteLLM, not by the harness directly.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_API_KEY=
# AZURE_API_BASE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# ---- Real guardrail provider keys (for local/litellm_config.yaml) --------
# LAKERA_API_KEY=
# APORIA_API_KEY=
# PRESIDIO_API_KEY=
# PANW_PRISMA_AIRS_API_KEY=

# ---- HuggingFace (only for scripts/build_corpus.py with gated datasets) --
# Needed to rebuild the corpus with MHJ + AgentHarm. Request access first:
#   https://huggingface.co/datasets/ScaleAI/mhj
#   https://huggingface.co/datasets/ai-safety-institute/AgentHarm
# HF_TOKEN=hf_...
